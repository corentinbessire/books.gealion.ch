{#
/**
 * @file
 * Default theme implementation for a 'form' element.
 *
 * Available variables
 * - attributes: A list of HTML attributes for the wrapper element.
 * - children: The child elements of the form.
 *
 * @see template_preprocess_form()
 *
 * @ingroup themeable
 */
#}
<form{{ attributes }}>
  {{ include('books:icon', {
        name: 'book-solid', fill: 'solid', view_box: '0 0 20 20',
        size: 'h-20 w-20', extra_classes: 'text-purple-500 mb-2',
      }) }}

  <p class="mb-5 text-3xl text-gray-600">{{ 'Login'|t }}</p>
  {{ children }}
</form>
