{#
/**
 * @file
 * Author term page heading.
 *
 * Same shape as the other term pages, with the author's portrait in place of
 * the fallback icon and the bio underneath.
 */
#}
{% embed 'books:term-hero' with {
  title: name,
  icon: 'user',
  image: content.field_image|render|trim is not empty,
  below: content.field_bio|render|trim is not empty,
} %}
  {% block image %}{{ content.field_image }}{% endblock %}
  {% block below %}{{ content.field_bio }}{% endblock %}
{% endembed %}
