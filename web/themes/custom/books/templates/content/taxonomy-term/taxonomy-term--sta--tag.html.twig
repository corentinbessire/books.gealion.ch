{#
/**
 * @file
 * A reading-status term rendered as a coloured pill.
 *
 * field_color drives which variant the pill uses; the colours themselves
 * live in the component.
 */
#}
{% set variant = {
  'success': 'success',
  'error': 'error',
}[term.field_color.value]|default('neutral') %}

{{ include('books:status-pill', {
  variant: variant,
  label: name,
  attributes: attributes,
}) }}
