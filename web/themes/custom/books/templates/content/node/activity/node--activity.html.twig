{#
/**
 * @file
 * One entry in the reading history.
 *
 * Two shapes. On a phone the cover sits beside a stacked block — title, then
 * the reading span, then the status — because four columns cannot fit in
 * 393px and the title, which is the thing you are actually scanning for,
 * was the column that collapsed. From md up it returns to a single row.
 */
#}
{% set has_end = content.field_end_date|render|trim is not empty %}
{# A book started and finished on the same day is one date, not a span. #}
{% set same_day = has_end and node.field_start_date.value == node.field_end_date.value %}

<div class="activity-card bg-cream border border-stone-300 rounded-lg p-4 sm:p-6
            grid grid-cols-[auto_1fr] md:grid-cols-[auto_1fr_auto_auto]
            gap-x-4 gap-y-2 md:gap-6
            items-start md:items-center
            transition-all duration-300 relative overflow-hidden">

  {# Cover: spans the stacked rows on mobile, one cell on desktop. #}
  <div class="row-span-3 md:row-span-1 w-16 h-24 shrink-0 rounded overflow-hidden shadow-sm">
    {{ content.extra_field_book_cover }}
  </div>

  {# Title: wraps to two lines on mobile rather than truncating to nothing. #}
  <div class="min-w-0">
    <h3 class="text-lg font-semibold text-ink line-clamp-2 md:truncate font-display">
      {{ label }}
    </h3>
  </div>

  {#
    The reading span: a period, not two unrelated dates. Each date stays
    atomic, but the line is allowed to wrap between them. Holding the whole
    span on one line sets a min-content floor the 1fr column cannot shrink
    below, which pushed the card 34px past its own edge under ~360px.
  #}
  <div class="col-start-2 md:col-start-3 min-w-0 text-sm text-ink-muted">
    <p class="flex flex-wrap items-center gap-x-2 gap-y-0.5">
      {{ include('books:icon', {
          name: 'calendar', size: 'w-4 h-4', stroke_width: '2',
          extra_classes: 'shrink-0 text-forest',
        }) }}
      {% if same_day %}
        <span class="font-medium text-ink whitespace-nowrap">{{ content.field_end_date }}</span>
      {% elseif has_end %}
        <span class="font-medium text-ink whitespace-nowrap">{{ content.field_start_date }}</span>
        {# The arrow travels with the date it points at, so a wrapped second
           line reads as a continuation rather than starting on a bare date. #}
        <span class="inline-flex items-center gap-2 whitespace-nowrap">
          <span aria-hidden="true">&rarr;</span>
          <span class="sr-only">{{ 'to'|t }}</span>
          <span class="font-medium text-ink">{{ content.field_end_date }}</span>
        </span>
      {% else %}
        <span>{{ 'Started'|t }}</span>
        <span class="font-medium text-ink whitespace-nowrap">{{ content.field_start_date }}</span>
      {% endif %}
    </p>
  </div>

  {# Status. #}
  <div class="col-start-2 md:col-start-4 justify-self-start">
    {{ content.field_status }}
  </div>
</div>
