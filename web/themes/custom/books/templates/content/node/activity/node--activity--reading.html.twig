<div class="reading-now">
  <div class="flex flex-col md:flex-row items-center gap-6">
    <!-- Book Cover -->
    <div class="w-40 flex-shrink-0 rounded-lg overflow-hidden shadow-lg">
      {{ content.extra_field_book_cover }}
    </div>

    <!-- Book Info -->
    <div class="flex-1 text-center md:text-left">
      <h3 class="text-2xl font-bold text-ink mb-2" style="font-family: var(--font-display);">
        {{ label }}
      </h3>
      <p class="text-ink-muted mb-4 flex items-center justify-center md:justify-start gap-2">
        <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span>{{ 'Started' | t }}</span>
        <span class="font-medium">{{ content.field_start_date }}</span>
      </p>
      {{ content.field_status }}

      {% if activity_actions is not empty %}
        <div class="mt-4 flex flex-wrap items-center justify-center gap-3 md:justify-start">
          {% for action, href in activity_actions %}
            {% set is_finish = action == 'finish' %}
            <div x-data="confirmAction('{{ href }}')" class="inline-flex items-center gap-2">
              <button type="button" x-show="!confirming" x-on:click="ask()"
                class="inline-flex items-center gap-1.5 rounded-md border px-3 py-1.5 text-sm font-semibold shadow-sm transition {{ is_finish ? 'border-burgundy bg-cream text-burgundy hover:bg-parchment' : 'border-stone-400 bg-stone-100 text-ink-muted hover:bg-stone-200' }}">
                {{ is_finish ? 'Mark as read'|t : 'Abandoned'|t }}
              </button>

              <span x-show="confirming" x-cloak style="display:none" class="inline-flex items-center gap-2 text-sm">
                <span class="text-ink-muted">{{ is_finish ? 'Finish it?'|t : 'Give up on it?'|t }}</span>
                <button type="button" x-on:click="go()"
                  class="rounded-md bg-burgundy px-2.5 py-1 text-sm font-semibold text-cream hover:opacity-90">
                  {{ 'Yes'|t }}
                </button>
                <button type="button" x-on:click="cancel()"
                  class="rounded-md px-2.5 py-1 text-sm text-ink-muted underline hover:text-ink">
                  {{ 'Cancel'|t }}
                </button>
              </span>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</div>
