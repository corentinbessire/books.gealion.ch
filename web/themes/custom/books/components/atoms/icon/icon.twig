{% if fill == 'solid' %}
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="{{ view_box }}" fill="currentColor"
       class="{{ size }} {{ extra_classes }}" aria-hidden="true">
    {{ paths[name]|raw }}
  </svg>
{% else %}
  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="{{ view_box }}"
       stroke-width="{{ stroke_width }}" stroke="currentColor"
       class="{{ size }} {{ extra_classes }}" aria-hidden="true">
    {{ paths[name]|raw }}
  </svg>
{% endif %}
