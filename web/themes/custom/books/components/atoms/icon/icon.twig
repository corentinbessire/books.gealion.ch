{#
/**
 * @file
 * A single inline SVG icon.
 *
 * Every icon in the theme is drawn from here, so a path is defined once and
 * the call sites carry no markup.
 *
 * Available props:
 * - name: which icon to draw (required).
 * - size: Tailwind sizing utilities, default 'h-6 w-6'.
 * - stroke_width: outline stroke width, default '1.5'.
 * - fill: 'outline' (default) or 'solid'.
 * - view_box: defaults to '0 0 24 24'; some icons are drawn on a 20x20 grid.
 * - extra_classes: colour or spacing utilities for the svg element.
 */
#}
