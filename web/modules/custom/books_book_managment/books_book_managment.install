<?php

/**
 * @file
 * Install, update and uninstall functions for Books - Book Managment.
 */

use Drupal\Core\Utility\UpdateException;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;

/**
 * Copy field_serie_number into field_serie_position and drop the old field.
 *
 * Hardcover reports series positions as floats (novellas sit at 1.5), which
 * the old integer field could not hold.
 *
 * The deploy pipeline runs `drush updatedb` before `drush config:import`, so
 * field_serie_position does not yet exist in active config when this runs on
 * production. The hook therefore creates the target field itself and refuses
 * to drop field_serie_number while any value is still unmigrated.
 *
 * @param array<string, mixed> $sandbox
 *   The update sandbox.
 *
 * @throws \Drupal\Core\Utility\UpdateException
 *   When at least one series number could not be migrated.
 */
function books_book_managment_update_11001(array &$sandbox): string {
  _books_book_managment_ensure_serie_position_field();

  // Nothing to migrate when the source field is already gone: the hook has
  // either run before or the site never had the old field.
  if (!FieldStorageConfig::loadByName('node', 'field_serie_number')) {
    return t('field_serie_number is already gone; nothing to migrate.');
  }

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $nids = $storage->getQuery()
    ->condition('type', 'book')
    ->exists('field_serie_number')
    ->accessCheck(FALSE)
    ->execute();

  $migrated = 0;
  foreach ($storage->loadMultiple($nids) as $node) {
    if (!$node->hasField('field_serie_position') || !$node->get('field_serie_position')->isEmpty()) {
      continue;
    }
    $value = $node->get('field_serie_number')->value;
    if ($value === NULL || $value === '') {
      continue;
    }
    $node->set('field_serie_position', (float) $value);
    $node->save();
    $migrated++;
  }

  // Never delete data this hook did not manage to copy. Re-query rather than
  // trusting the loop counter: a node skipped by the guard above would
  // otherwise be silently discarded along with the old field storage.
  $leftBehind = $storage->getQuery()
    ->condition('type', 'book')
    ->exists('field_serie_number')
    ->notExists('field_serie_position')
    ->accessCheck(FALSE)
    ->count()
    ->execute();

  if ($leftBehind > 0) {
    throw new UpdateException(sprintf(
      'Migrated %d series positions, but %d book(s) still hold a field_serie_number that was not copied. field_serie_number has been kept so no data is lost; resolve those nodes and re-run the update.',
      $migrated,
      $leftBehind
    ));
  }

  FieldStorageConfig::loadByName('node', 'field_serie_number')->delete();

  return t('Migrated @count series positions and removed field_serie_number.', [
    '@count' => $migrated,
  ]);
}

/**
 * Creates field_serie_position when active config does not have it yet.
 *
 * The values mirror config/sync/field.storage.node.field_serie_position.yml
 * and config/sync/field.field.node.book.field_serie_position.yml exactly —
 * UUIDs included, since a differing UUID would show up as a pending change —
 * so the config:import that follows the database update finds no difference.
 */
function _books_book_managment_ensure_serie_position_field(): void {
  if (!FieldStorageConfig::loadByName('node', 'field_serie_position')) {
    FieldStorageConfig::create([
      'uuid' => '9b7627a8-e1ae-4fb2-9734-1b5f206a07c4',
      'langcode' => 'en',
      'status' => TRUE,
      'field_name' => 'field_serie_position',
      'entity_type' => 'node',
      'type' => 'decimal',
      'settings' => [
        'precision' => 6,
        'scale' => 2,
      ],
      'module' => 'core',
      'locked' => FALSE,
      'cardinality' => 1,
      'translatable' => TRUE,
      'indexes' => [],
      'persist_with_no_fields' => FALSE,
      'custom_storage' => FALSE,
    ])->save();
  }

  if (!FieldConfig::loadByName('node', 'book', 'field_serie_position')) {
    FieldConfig::create([
      'uuid' => 'acf12985-c2d2-4e46-8687-dc54af2118c6',
      'langcode' => 'en',
      'status' => TRUE,
      'field_name' => 'field_serie_position',
      'entity_type' => 'node',
      'bundle' => 'book',
      'label' => 'Series position',
      'description' => '',
      'required' => FALSE,
      'translatable' => TRUE,
      'default_value' => [],
      'default_value_callback' => '',
      'settings' => [
        'min' => NULL,
        'max' => NULL,
        'prefix' => '',
        'suffix' => '',
      ],
      'field_type' => 'decimal',
    ])->save();
  }
}
