<?php

/**
 * @file
 * Primary module hooks for Books - Activity module.
 *
 * @DCG
 * This file is no longer required in Drupal 8.
 * @see https://www.drupal.org/node/2217931
 */

use Drupal\Core\Url;
use Drupal\node\NodeInterface;

/**
 * Set the title of the Book as Activity Title.
 *
 * @param \Drupal\node\Entity\Node $node
 *   The Activity being created.
 */
function books_activity_node_presave($node) {
  if ($node->bundle() === 'activity') {
    if ($book = $node->get('field_book')->entity) {
      $node->set('title', $book->label());
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for node templates.
 *
 * Offers the reading-log transitions on activities that can actually take
 * them. This is presentation only — ActivityController enforces the same rule
 * server-side, because hiding a button does not protect the route behind it.
 *
 * @phpstan-param array<string, mixed> $variables
 */
function books_activity_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if (!$node instanceof NodeInterface || $node->bundle() !== 'activity') {
    return;
  }

  // Varies per user because the links are permission-gated, and per activity
  // because a finished activity offers nothing.
  $variables['#cache']['contexts'][] = 'user.permissions';
  $variables['activity_actions'] = [];

  if (!\Drupal::currentUser()->hasPermission('edit any activity content')) {
    return;
  }

  if (!\Drupal::service('books_activity.status')->isReading($node)) {
    return;
  }

  $variables['activity_actions'] = [
    'finish' => Url::fromRoute('books_activity.finish', ['activity' => $node->id()])->toString(),
    'abandon' => Url::fromRoute('books_activity.abandon', ['activity' => $node->id()])->toString(),
  ];
}
