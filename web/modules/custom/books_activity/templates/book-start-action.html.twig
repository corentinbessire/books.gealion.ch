{#
/**
 * @file
 * Start reading / Reread button for a book.
 *
 * Swaps itself for a Yes/Cancel pair before acting, because a single click
 * opens a reading activity dated today.
 *
 * Available variables:
 * - action: 'start' when the book has never been read, 'reread' otherwise.
 * - url: URL that opens the reading activity.
 */
#}
<div x-data="confirmAction('{{ url }}')" class="mt-6 inline-flex items-center gap-2">
  <button type="button" x-show="!confirming" x-on:click="ask()"
    class="inline-flex items-center gap-2 rounded-md border border-burgundy bg-cream px-3.5 py-2.5 text-sm font-semibold text-burgundy shadow-sm transition hover:bg-parchment focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-burgundy">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
    </svg>
    {{ action == 'reread' ? 'Reread'|t : 'Start reading'|t }}
  </button>

  <span x-show="confirming" x-cloak style="display:none" class="inline-flex items-center gap-2 text-sm">
    <span class="text-ink-muted">{{ action == 'reread' ? 'Read it again?'|t : 'Start reading it?'|t }}</span>
    <button type="button" x-on:click="go()"
      class="rounded-md bg-burgundy px-2.5 py-1 text-sm font-semibold text-cream hover:opacity-90">{{ 'Yes'|t }}</button>
    <button type="button" x-on:click="cancel()"
      class="rounded-md px-2.5 py-1 text-sm text-ink-muted underline hover:text-ink">{{ 'Cancel'|t }}</button>
  </span>
</div>
